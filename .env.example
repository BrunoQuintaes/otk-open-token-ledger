# OTK zk-Metering — Environment Variables
# Copy to .env (DO NOT COMMIT .env)
#
# Usage: cp .env.example .env && edit .env
#
# Sections:
#   1. Runtime (required for docker compose)
#   2. API Server
#   3. ProverDaemon
#   4. PostgreSQL (Phase 2)
#   5. AI Providers (for provider-level testing)
#   6. On-chain (Besu IBFT, optional)

# ─── 1. Runtime — required for `docker compose -f docker-compose.prod.yml up` ──

# Admin key for /admin/* endpoints.
# Required by docker-compose.prod.yml. Use a strong random value in production.
OTK_ADMIN_KEY=changeme-replace-in-production

# PostgreSQL password.
# Required by docker-compose.prod.yml when running the postgres service.
POSTGRES_PASSWORD=changeme-replace-in-production

# ─── 2. API Server ───────────────────────────────────────────────────────────────

# HTTP listen port (default: 8787)
# API_PORT=8787

# Multi-tenant bearer auth (env-gated — disabled when unset).
# Format: "tenantA:tokenABC,tenantB:tokenXYZ"
# When set, POST /receipts and GET /receipts/:id require Authorization: Bearer <token>
# OTK_TENANTS=tenant1:secret-token-1,tenant2:secret-token-2

# JSONL receipt log path (Phase 1 durability — written on every receipt).
# Restored on startup. Leave empty to disable JSONL persistence.
# OTK_RECEIPT_LOG=/data/receipts.jsonl

# PostgreSQL write-behind connection string (Phase 2 durability).
# When set alongside OTK_REDIS_URL, enables full stateful backend (Phase 2).
# In docker-compose: postgres://otk:${POSTGRES_PASSWORD}@postgres:5432/otk
# OTK_DB_URL=postgres://otk:changeme@localhost:5432/otk

# Rate limit: max requests per tenant per 60s (default: 1000)
# OTK_RL_MAX_REQUESTS=1000

# Auth failure rate limit of the API: max failures per SOURCE address per 60s (default: 20).
# F-H1-07: keyed by source (same rules as OTK_PROXY_TRUSTED_HOPS below), no longer by token prefix.
# OTK_AUTH_FAIL_MAX=20

# H1 lane B (S04 residual): with OTK_DB_URL, tenant deactivation / user deprovisioning is shared by every replica
# through PostgreSQL (table otk_subject_status). Each replica refreshes its cache at most every TTL ms (bounded
# staleness); on a store error the last snapshot is kept (a tenant seen as deactivated stays deactivated).
# OTK_SUBJECT_STATUS_TTL_MS=2000

# H1-S06 (SEC02-N02): MITM proxy limiter of authentication failures, per SOURCE address (never per tenant).
# After MAX failed authentications in WINDOW_MS the source gets 429 (Retry-After) for the rest of the window.
# 0 disables. TRUSTED_HOPS>0 takes the n-th address from the right of X-Forwarded-For (only behind your own proxies).
# H1 lane B: with OTK_REDIS_URL the failure count is also shared by the replicas (Redis sliding window).
# OTK_PROXY_AUTH_FAIL_MAX=20
# OTK_PROXY_AUTH_FAIL_WINDOW_MS=60000
# OTK_PROXY_AUTH_FAIL_MAX_SOURCES=10000
# OTK_PROXY_TRUSTED_HOPS=0

# Git commit SHA — exposed at GET /version as gitHead (injected by CI or at deploy time)
# GIT_HEAD=

# ProverDaemon URL (default: http://localhost:3001; in compose: http://prover:3001)
# PROVER_URL=http://prover:3001

# Circuit breaker: consecutive Prover failures before opening (default: 5)
# PROVER_CB_THRESHOLD=5

# Default ZK circuit version to use (1 or 2; default: 2 — MPC key)
# OTK_CIRCUIT_DEFAULT=2

# ─── 3. ProverDaemon ─────────────────────────────────────────────────────────────

# HTTP listen port (default: 3001)
# PROVER_PORT=3001

# Redis URL for BullMQ queue (Phase 2 — enables distributed proving).
# In docker-compose: redis://redis:6379
# Leave empty to use Phase 1 in-process DurableProofQueue (no Redis required).
# OTK_REDIS_URL=redis://localhost:6379

# Redis password (SEC-05: required for production)
# REDIS_PASSWORD=changeme-replace-in-production

# JSONL proof queue log (Phase 1 queue durability — leave empty to disable)
# OTK_PROOF_QUEUE_LOG=/data/proof_queue.jsonl

# ZK artifact paths (defaults match docker image layout — override for custom mounts)
# PROVER_WASM_V1=zk/build/metering_v1_js/metering_v1.wasm
# PROVER_WASM_V2=zk/build/metering_v2_js/metering_v2.wasm
# PROVER_ZKEY_V2=zk/keys/metering_v2_final_mpc.zkey
# NOTE: v1 key (metering_v1_final.zkey) is NOT in the repo.
# To enable v1 proving, mount the key and set:
# PROVER_ZKEY_V1=/path/to/metering_v1_final.zkey

# ─── 4. PostgreSQL (Phase 2) ─────────────────────────────────────────────────────

# Database name (default: otk)
# POSTGRES_DB=otk

# Database user (default: otk)
# POSTGRES_USER=otk

# POSTGRES_PASSWORD is in section 1 (required when postgres service is used)

# ─── 5. AI Providers (for provider-level testing — B-P1) ─────────────────────────

# OpenAI
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-sonnet-4

# ─── 6. On-chain (Besu IBFT — optional) ──────────────────────────────────────────

# RPC endpoint for the IBFT network
# RPC=http://127.0.0.1:9545

# EVM chain ID (Besu IBFT default: 1337)
# CHAIN_ID=1337

# Deployer/signer private key — NEVER commit a real private key
# PRIVKEY=0x...
