{
  "name": "otk-zk-metering",
  "version": "0.1.0",
  "description": "Multi-provider AI metering with ZK proofs and on-chain verification",
  "type": "module",
  "scripts": {
    "reproduzir-tudo": "node --import ./reproducao/ferramentas/sem_rede.mjs reproducao/reproduzir_tudo.mjs",
    "testes-banca": "node reproducao/testes_banca.mjs",
    "reproduzir-ao-vivo": "node --import ./reproducao/ferramentas/sem_rede.mjs reproducao/ao_vivo/reproduzir_ao_vivo.mjs",
    "test:ao-vivo": "node --import ./reproducao/ferramentas/sem_rede.mjs --test --test-concurrency=1 \"test/reproducao_ao_vivo/*.test.mjs\"",
    "demo-banca": "node --import tsx demo/demo_banca.mts",
    "test": "tsx --test test/unit/*.test.ts test/pricing/*.test.ts test/sdk/*.test.ts test/security/*.test.ts test/integration/*.test.ts test/receipt/*.test.ts test/zk/*.test.ts",
    "test:tap": "tsx --test --test-reporter=tap test/unit/*.test.ts test/pricing/*.test.ts test/sdk/*.test.ts test/security/*.test.ts test/integration/*.test.ts test/receipt/*.test.ts test/zk/*.test.ts",
    "test:watch": "tsx --test --watch test/unit/*.test.ts test/pricing/*.test.ts test/sdk/*.test.ts test/security/*.test.ts test/integration/*.test.ts test/receipt/*.test.ts test/zk/*.test.ts",
    "test:security": "tsx --test test/security/*.test.ts",
    "test:chain": "tsx --test test/chain/*.test.ts",
    "test:receipt": "tsx --test test/receipt/*.test.ts",
    "test:unit": "tsx --test test/unit/*.test.ts",
    "test:pricing": "tsx --test test/pricing/*.test.ts",
    "test:sdk": "tsx --test test/sdk/*.test.ts",
    "test:integration": "tsx --test test/integration/*.test.ts",
    "test:zk": "tsx --test test/zk/*.test.ts",
    "test:verifier": "tsx --test test/verifier/*.test.ts",
    "otk": "tsx scripts/verify/otk.ts",
    "verifier:vectors": "tsx test/verifier/gera_vetores.ts",
    "hardhat:compile": "cd tools/hardhat && npx hardhat compile",
    "hardhat:test": "cd tools/hardhat && node --test test/ReceiptRegistry.test.js test/OnChainPubSignalsBinding.test.js",
    "u4.1:verify": "npm run -s hardhat:compile && npm run -s hardhat:test",
    "benchmark": "tsx scripts/benchmark/u9_benchmark_harness.ts",
    "demo": "tsx scripts/demo/u10_demo_e2e.ts",
    "indexer": "tsx scripts/indexer/receipt_indexer.ts",
    "indexer:export": "tsx scripts/indexer/export_dashboard_csv.ts",
    "demo:e5": "tsx scripts/demo/e5_enterprise_demo.ts"
  },
  "keywords": [
    "zk",
    "metering",
    "receipts",
    "groth16",
    "multi-provider"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bullmq": "^5.71.0",
    "circomlibjs": "^0.1.7",
    "docx": "^9.6.1",
    "ethers": "^6.16.0",
    "ioredis": "^5.10.0",
    "js-tiktoken": "^1.0.21",
    "nodemailer": "^10.0.16",
    "pg": "^8.20.0",
    "prom-client": "^15.1.3",
    "snarkjs": "^0.7.6",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.18.0",
    "playwright": "^1.59.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "ws": "^8.21.0",
    "uuid": "^11.1.1",
    "nanoid": "^5.1.16",
    "minimatch": "^5.1.9",
    "brace-expansion": "^2.1.7",
    "underscore": "^1.13.8",
    "jsonpath": "^1.3.0"
  }
}
